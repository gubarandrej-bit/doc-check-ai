# Режим работы: local | cloud | hybrid
MODE=local

# Безопасность — ОБЯЗАТЕЛЬНО замените на случайную строку!
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME

# БД (в docker используется sqlite:////data/doccheck.db)
DATABASE_URL=sqlite:///data/doccheck.db

# Фронтенд
FRONTEND_URL=http://localhost

# --- AI-слой: облачные модели (OpenRouter) ---
OPENROUTER_API_KEY=
AI_DEFAULT_PROVIDER=openrouter
AI_DEFAULT_MODEL=openrouter/free

# --- AI-слой: локальные модели (Ollama) ---
# Внутри docker-compose адрес переопределяется на http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b

# --- Разбор чертежей ---
# Путь к ODA File Converter (конвертирует DWG в DXF).
# Программа сторонняя, ставится отдельно — см. INSTALL.md.
# Внутри контейнера путь фиксирован монтированием в /opt/oda
ODA_CONVERTER_PATH=/opt/oda/ODAFileConverter

# Максимальный размер загружаемого файла, МБ
MAX_FILE_SIZE=200